# Stage 1: Build Fleet Microservices
FROM maven:3.9.6-eclipse-temurin-21 AS build
WORKDIR /build

COPY backend-springboot/pom.xml .
COPY backend-springboot/safebus-common ./safebus-common
COPY backend-springboot/eureka-server ./eureka-server
COPY backend-springboot/config-server ./config-server
COPY backend-springboot/api-gateway ./api-gateway
COPY backend-springboot/auth-service ./auth-service
COPY backend-springboot/student-service ./student-service
COPY backend-springboot/transport-service ./transport-service
COPY backend-springboot/attendance-service ./attendance-service
COPY backend-springboot/notification-service ./notification-service

RUN mvn clean package -pl safebus-common,transport-service,attendance-service,notification-service,config-server -am -T 1C -DskipTests

# Stage 2: Runtime Image with Java 21 + Python 3.11
FROM eclipse-temurin:21-jdk-jammy

WORKDIR /app

# Install Python 3, pip, curl, and required OpenCV libraries
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-pip \
    python3-dev \
    curl \
    libgl1 \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender-dev \
    && rm -rf /var/lib/apt/lists/*

# Install Python requirements for CV Monitor
COPY backend/requirements-cv.txt ./backend/requirements-cv.txt
RUN pip3 install --no-cache-dir -r ./backend/requirements-cv.txt

# Copy Python CV service files
COPY backend/ ./backend/

# Copy compiled microservice JARs
COPY --from=build /build/transport-service/target/safebus-transport-service-1.0.0.jar ./transport-service.jar
COPY --from=build /build/attendance-service/target/safebus-attendance-service-1.0.0.jar ./attendance-service.jar
COPY --from=build /build/notification-service/target/safebus-notification-service-1.0.0.jar ./notification-service.jar
COPY --from=build /build/config-server/src/main/resources/config ./config

# Copy fleet startup script
COPY start_fleet.sh ./start_fleet.sh
RUN tr -d '\r' < ./start_fleet.sh > ./start_fleet_unix.sh && mv ./start_fleet_unix.sh ./start_fleet.sh && chmod +x ./start_fleet.sh

ENV PORT=8083
EXPOSE 8083 8084 8086 5001

ENTRYPOINT ["./start_fleet.sh"]
